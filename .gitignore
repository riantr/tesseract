.DS_Store
_build/
target/
target
.mooncakes/
.moonagent/
dist/

# The coverage reporter's output. `moon coverage analyze -- -f cobertura`
# writes cobertura.xml into the working directory, and it is a measurement of
# the tree rather than part of it.
cobertura.xml
_coverage/

# The logs a measurement run writes while it runs. They are output, not part
# of the tree, and a gate run that leaves one behind must not stage it.
*.log