///|
/// Can this store record a real dataset?
///
/// The dataset is generated by `riantr/moonbit_doubleML`'s DGPs and is seeded,
/// so every assertion here is about fixed data rather than about a run that
/// happened to pass. The tests compare doubles with `==`, not with a tolerance:
/// a store that rounds a value by one ulp is not recording the data it was
/// given, and a tolerance would hide exactly the defect these tests exist to
/// find.

///|
fn fresh() -> @tesseract.Tesseract {
  @tesseract.new_db(
    "tesseract",
    @tesseract.default_lattice(),
    @tesseract.new_logger("test"),
  )
}

///|
/// Records `data` and reads it straight back, so a test body can compare the
/// two. `None` from `read_back` means a row was missing or undecodable, which
/// the callers assert on separately from a wrong value.
fn round_trip(
  data : @tesseract_dgp.Dataset,
) -> Array[@tesseract_dgp.Observation]? {
  let db = fresh()
  ignore(@tesseract_dgp.record(db, data))
  @tesseract_dgp.read_back(db, data)
}

///|
/// Asserts every field of every observation survives unchanged, and reports
/// the first field that does not.
///
/// Written as one walking comparison rather than as a loop of `assert_eq`
/// calls: a loop that fails on row 3 of 81 says only "some assertion failed",
/// and the point of these tests is to say *which number*.
fn assert_identical(
  want : Array[@tesseract_dgp.Observation],
  got : Array[@tesseract_dgp.Observation],
) -> Unit raise {
  assert_eq(got.length(), want.length())
  for i = 0; i < want.length(); i = i + 1 {
    let w = want[i]
    let g = got[i]
    assert_eq(g.index, w.index)
    // `==` on Double is bit equality here because both sides came from the same
    // finite value: NaN would break it, which is why `encode` refuses NaN.
    assert_true(g.d == w.d)
    assert_true(g.y == w.y)
    assert_eq(g.x.length(), w.x.length())
    for j = 0; j < w.x.length(); j = j + 1 {
      assert_true(g.x[j] == w.x[j])
    }
  }
}

///|
test "the IRM DGP gives a lattice-shaped dataset, not a degenerate one" {
  let data = @tesseract_dgp.irm_dataset(81, 4, 0.5, 42)
  assert_eq(data.source, "make_irm_data")
  assert_eq(data.dim_x, 4)
  assert_eq(data.observations.length(), 81)
  // Binary treatment: exactly 0.0 or 1.0, and both actually occur. Without
  // this the round-trip test below could pass against a column of zeros.
  let mut zeros = 0
  let mut ones = 0
  for obs in data.observations {
    assert_true(obs.d == 0.0 || obs.d == 1.0)
    if obs.d == 1.0 {
      ones = ones + 1
    } else {
      zeros = zeros + 1
    }
  }
  assert_true(zeros > 0)
  assert_true(ones > 0)
  // Outcomes must vary, or "every value round-tripped" would be vacuous.
  assert_true(data.observations[0].y != data.observations[80].y)
  assert_true(data.observations[0].x[1] != data.observations[80].x[1])
}

///|
test "every IRM value survives the lattice unchanged" {
  let data = @tesseract_dgp.irm_dataset(81, 4, 0.5, 42)
  match round_trip(data) {
    None => assert_true(false)
    Some(back) => assert_identical(data.observations, back)
  }
}

///|
test "every confounded PLR value survives the lattice unchanged" {
  // The IRM treatment is binary, so half its `d` column is 0.0 or 1.0 - values
  // that survive almost any encoding. This DGP's `d` is continuous and
  // confounded, so every entry is an arbitrary double. A store that quietly
  // rounded or reformatted numbers would still pass the IRM test and fail
  // here, which is exactly why both exist.
  let data = @tesseract_dgp.plr_dataset(81, 4, 0.5, 7)
  assert_eq(data.observations.length(), 81)
  let mut non_binary = 0
  for obs in data.observations {
    if obs.d != 0.0 && obs.d != 1.0 {
      non_binary = non_binary + 1
    }
  }
  assert_eq(non_binary, 81)
  match round_trip(data) {
    None => assert_true(false)
    Some(back) => assert_identical(data.observations, back)
  }
}

///|
test "the lattice holds the encoded text verbatim" {
  // Separate from the decode test on purpose. `decode` proving the right
  // numbers came back does not prove the lattice kept the bytes: a store that
  // rewrote the text into an equivalent form would pass the decode test and
  // fail this one.
  let data = @tesseract_dgp.plr_dataset(12, 4, 0.5, 7)
  let db = fresh()
  let report = @tesseract_dgp.record(db, data)
  assert_eq(report.recorded, 12)
  assert_eq(report.rejected, 0)
  let rows = @tesseract_dgp.recorded(db)
  assert_eq(rows.length(), 12)
  for i = 0; i < 12; i = i + 1 {
    // `encode` is total for a finite observation, so the None arm is a bug in
    // the data rather than a condition to tolerate.
    let want = match @tesseract_dgp.encode(data.observations[i]) {
      Some(t) => t
      None => abort("encode refused a finite observation")
    }
    assert_eq(rows[i].value, want)
    assert_eq(rows[i].position, i.to_int64() + 1L)
    assert_eq(rows[i].key, @tesseract_dgp.observation_key(i))
  }
}

///|
test "encoding is exact for the doubles that are hard to print" {
  // The round-trip tests only exercise the 162 doubles two DGPs happened to
  // draw. These are the values a decimal format is most likely to get wrong;
  // if `Double::to_string` were not round-trip exact, this is where it shows.
  let hard = [
    0.1,
    0.2,
    0.3,
    1.0 / 3.0,
    2.0 / 3.0,
    1.0e-300,
    1.0e300,
    5.0e-324,
    2.2250738585072014e-308,
    1.7976931348623157e308,
    123456789.123456789,
    0.30000000000000004,
    1.0e-10,
    1.0e10,
    -2.5,
    3.141592653589793,
  ]
  for v in hard {
    let obs = @tesseract_dgp.Observation::new(0, v, v, [v])
    // Both refusals are bugs rather than conditions: every value here is
    // finite, and every one of them is representable as text by construction.
    let text = match @tesseract_dgp.encode(obs) {
      Some(t) => t
      None => abort("encode refused a finite double")
    }
    match @tesseract_dgp.decode(text) {
      Some(back) => {
        // `==`, not a tolerance: a one-ulp difference is already a failure to
        // record what was given.
        assert_true(back.d == v)
        assert_true(back.y == v)
        assert_true(back.x[0] == v)
      }
      None => abort("decode refused text this package wrote")
    }
  }
}

///|
test "a dataset larger than the lattice is refused, not wrapped" {
  // 93 rows, 81 cells. Wrapping would overwrite rows 1..12 and then report
  // "recorded 93", which is a lie about what is in the store.
  let lat = @tesseract.default_lattice()
  let extra = 12L
  let data = @tesseract_dgp.irm_dataset(93, 4, 0.5, 42)
  let db = fresh()
  let report = @tesseract_dgp.record(db, data)
  assert_eq(report.offered, 93)
  assert_eq(report.recorded, lat.total().to_int())
  assert_eq(report.rejected, extra.to_int())
  assert_eq(report.stopped_at, lat.last_position() + 1L)
  assert_eq(@tesseract.Tesseract::occupancy(db), lat.total())
  // The first `lat.total()` are the first `lat.total()` - the overflow must not have
  // clobbered them.
  let rows = @tesseract_dgp.recorded(db)
  assert_eq(rows[0].key, @tesseract_dgp.observation_key(0))
  assert_eq(
    rows[@tesseract.slot_of(lat.last_position())].key,
    @tesseract_dgp.observation_key(lat.total().to_int() - 1),
  )
}

///|
test "a non-finite value is refused rather than stored as unreadable text" {
  let nan = 0.0 / 0.0
  let inf = 1.0 / 0.0
  assert_true(nan - nan != 0.0)
  assert_true(inf - inf != 0.0)
  // Encoding must decline, so no lattice ever holds `NaN` or `Infinity` -
  // neither is a JSON number, and such a row would be stored but unreadable.
  assert_eq(
    @tesseract_dgp.encode(@tesseract_dgp.Observation::new(0, nan, 1.0, [1.0])),
    None,
  )
  assert_eq(
    @tesseract_dgp.encode(@tesseract_dgp.Observation::new(0, 1.0, inf, [1.0])),
    None,
  )
  assert_eq(
    @tesseract_dgp.encode(@tesseract_dgp.Observation::new(0, 1.0, 1.0, [nan])),
    None,
  )
  let db = fresh()
  let bad = @tesseract_dgp.Dataset::new("hand-built", 0.0, 1, [
    @tesseract_dgp.Observation::new(0, 1.0, 1.0, [1.0]),
    @tesseract_dgp.Observation::new(1, nan, 1.0, [1.0]),
    @tesseract_dgp.Observation::new(2, 2.0, 2.0, [2.0]),
  ])
  let report = @tesseract_dgp.record(db, bad)
  assert_eq(report.offered, 3)
  assert_eq(report.recorded, 2)
  assert_eq(report.rejected, 1)
  // The rows either side of the refused one still recorded, at their own cells.
  let rows = @tesseract_dgp.recorded(db)
  assert_eq(rows[0].key, @tesseract_dgp.observation_key(0))
  assert_eq(rows[1].key, @tesseract_dgp.observation_key(2))
}

///|
test "the dataset also reaches the store through SQL" {
  // The path a person actually uses: `to_sql` hands the rows to the project's
  // own parser, which is what `cmd/main` and `cmd/persist` run. If the encoder
  // and the parser disagree anywhere, this is where it shows.
  let data = @tesseract_dgp.plr_dataset(12, 4, 0.5, 7)
  let script = @tesseract_dgp.to_sql(data)
  let db = fresh()
  match @tesseract.import_sql(db, script) {
    Ok(n) => assert_eq(n, 12)
    Err(e) => abort("import_sql rejected the generated script: " + e)
  }
  assert_eq(@tesseract.Tesseract::occupancy(db), 12)
  let rows = @tesseract_dgp.recorded(db)
  assert_eq(rows.length(), 12)
  for i = 0; i < 12; i = i + 1 {
    assert_eq(rows[i].key, @tesseract_dgp.observation_key(i))
    assert_eq(rows[i].position, i.to_int64() + 1L)
    match @tesseract_dgp.decode(rows[i].value) {
      Some(back) => {
        assert_true(back.d == data.observations[i].d)
        assert_true(back.y == data.observations[i].y)
        for j = 0; j < data.dim_x; j = j + 1 {
          assert_true(back.x[j] == data.observations[i].x[j])
        }
      }
      None => abort("the parser stored something this package cannot read back")
    }
  }
}

///|
test "a DGP is a function of its seed" {
  // Two runs, same seed: identical data. This is what lets the other tests be
  // statements about fixed numbers instead of about one lucky run.
  let a = @tesseract_dgp.plr_dataset(81, 4, 0.5, 7)
  let b = @tesseract_dgp.plr_dataset(81, 4, 0.5, 7)
  assert_identical(a.observations, b.observations)
}

///|
/// The cell count is the lattice's own, not a number written into this file.
///
/// A dataset cannot be bigger than the lattice it is recorded into, and the
/// lattice is whichever side the store was built at. A constant here would
/// have been right for one side and quietly wrong for every other — the same
/// answer for two different stores.
test "the cell count is the lattice's own" {
  let three = @tesseract.new_db(
    "tesseract",
    @tesseract.lattice_of(3L).unwrap(),
    @tesseract.new_logger("test"),
  )
  assert_eq(@tesseract_dgp.cell_count(three), 81L)
  let four = @tesseract.new_db(
    "tesseract",
    @tesseract.lattice_of(4L).unwrap(),
    @tesseract.new_logger("test"),
  )
  assert_eq(@tesseract_dgp.cell_count(four), 256L)
}
